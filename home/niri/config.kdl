// niri config — https://github.com/YaLTeR/niri/wiki/Configuration:-Overview
// Full option reference: https://yalter.github.io/niri/Configuration:-Introduction

// Strip client-side window decorations for a consistent, borderless look
// across GTK/Qt apps — this is the fix for "no coherence between window
// headers", since different toolkits draw wildly different titlebars otherwise.
prefer-no-csd

input {
    keyboard {
        xkb {
            layout "us,fr,kr"      // AZERTY (fr) added — toggle cycles through all three
            options "grp:win_space_toggle"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
}

output "eDP-1" {
    // adjust to your actual output name (`niri msg outputs` after first login)
    scale 1.0
}

// Update the systemd/D-Bus activation environment as early as possible —
// several autostarted things (the polkit agent, xdg-desktop-portal,
// vicinae's systemd service) rely on WAYLAND_DISPLAY and friends already
// being visible to systemd/dbus activation, not just this process's own env.
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP=niri"

// Autostart Noctalia shell on session launch — this runs through Quickshell
// (`qs`) with the noctalia-shell config, NOT a standalone "noctalia-shell"
// binary (that binary doesn't exist, which is why this never actually
// started before).
spawn-at-startup "qs" "-c" "noctalia-shell"

// Vicinae's daemon is now started by its own systemd user service (see
// programs.vicinae.systemd.enable in home.nix) rather than spawned here —
// Mod+Space's bind still just talks to it as a client.

// Polkit authentication agent — needed for GUI privilege prompts (Dolphin
// mounting drives, NetworkManager, etc.); niri has no compositor built-in one.
spawn-at-startup "hyprpolkitagent"

layout {
    gaps 12
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#cba6f7"    // Catppuccin Mocha mauve — replaces the default bright blue
        inactive-color "#585b70"  // subtle, low-contrast when unfocused
    }
}

// Rounded corners on every window, clipped so content doesn't poke out past
// them — this is the fix for the focus ring appearing square behind rounded
// corners; without clip-to-geometry, the ring is drawn to the window's actual
// (square) bounds regardless of the visual corner radius.
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

binds {
    Mod+Return { spawn "ghostty"; }
    Mod+D { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "toggle"; }
    Mod+Space { spawn "vicinae" "vicinae://toggle"; }
    Mod+L { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "lockScreen" "lock"; }
    Mod+Q { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    Mod+Shift+E { quit; }
    Print { screenshot; }
}
